# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
# Comma separated list of API keys that are allowed to call the gateway.
# Leave blank to disable auth (NOT recommended in production).
NEUROROUTER_API_KEYS=dev-key-123

# Token required in the X-Admin-Token header for /v1/admin/* endpoints
# (key management, runtime config, provider enable/disable). Change this
# before deploying anywhere public.
NEUROROUTER_ADMIN_TOKEN=admin-dev-token

# ---- Providers ----
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional fallback providers (leave blank to skip)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# If no provider keys are set at all, the gateway automatically falls back
# to MockProvider so you can run/demo the whole system with zero API keys.

# ---- Cache ----
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=2000

# ---- Rate limiting ----
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Circuit breaker ----
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30
